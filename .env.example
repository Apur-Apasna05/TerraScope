# TerraScope Environment Configuration Template
# Copy this file to .env and populate secrets locally. NEVER commit .env.

# --- Frontend / Browser Keys (HTTP-referrer restricted) ---
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_CESIUM_ION_TOKEN=
VITE_API_BASE_URL=http://localhost:8000

# --- Backend / Server-Only Keys (IP/API restricted, never exposed to frontend bundle) ---
GOOGLE_MAPS_SERVER_KEY=
CESIUM_ION_TOKEN=
NASA_FIRMS_API_KEY=

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_USER=terrascope
POSTGRES_PASSWORD=terrascope_dev_password
POSTGRES_DB=terrascope
DATABASE_URL=postgresql+psycopg://terrascope:terrascope_dev_password@localhost:5432/terrascope

# --- Backend Runtime ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CONFIG_PATH=config/terrascope.yaml
